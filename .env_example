# ==============================================================================
# Configuration file for Nordic Transit Departure Board
# ==============================================================================

# 1. MET Norway Weather API (Required for weather forecasts across the Nordics)
# Meteorologisk institutt requires every individual user/installation to identify
# themselves with their own name/app and contact info (email or website URL).
MET_USER_AGENT="MyTransitBoard/1.0 (contact: user@example.com)"

# 2. Norway / Entur (Required ONLY if viewing Norwegian stop places)
# Format: <company/user>-<application>
ET_CLIENT_NAME="myname-transit-5821"

# 3. Finland / Digitransit (Optional: free subscription key from digitransit.fi/en/developers/)
# DIGITRANSIT_SUBSCRIPTION_KEY="your-key-here"

# 4. Optional: Default interface language ('no', 'sv', 'fi', 'en')
# LANGUAGE="no"
